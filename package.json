{
  "name": "pragma-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run --filter pragma tauri:dev",
    "dev:pragma": "bun run --filter pragma tauri:dev",
    "dev:www": "bun run --filter www dev",
    "jev": "bun packages/jev/src/cli.ts",
    "dev:go": "bun run --filter pragma-go start",
    "dev:go:ios": "bun run --filter pragma-go ios",
    "dev:go:android": "bun run --filter pragma-go android",
    "benchmark": "bun run --filter @pragma-sh/bench start",
    "gateway:smoke": "bun scripts/gateway-sdk-smoke.ts",
    "plugins:lock": "bun run --filter @pragma-sh/plugin-registry lock",
    "plugins:lock:local": "bun run --filter @pragma-sh/plugin-registry lock:local",
    "plugins:validate": "bun run --filter @pragma-sh/plugin-registry validate",
    "video:music": "bun launch-video/generate-lofi.ts",
    "video:studio": "remotion studio launch-video/index.ts",
    "video:render": "remotion render launch-video/index.ts PragmaLaunch .github/assets/pragma-launch.mp4",
    "video:typecheck": "tsc -p launch-video/tsconfig.json --noEmit",
    "generate": "turbo run generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck && bun run video:typecheck",
    "test": "bun test scripts/*.test.ts && turbo run test",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --workspace",
    "fallow:check": "fallow audit --base main --gate new-only --fail-on-issues",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run rust:fmt:check && bun run rust:clippy",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/design.md": "^0.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/media": "4.0.541",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.25.12",
    "fallow": "^2.104.0",
    "husky": "^9.1.7",
    "json-schema-to-typescript": "^15.0.4",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.54.0",
    "oxlint": "~1.78.0",
    "remotion": "4.0.541",
    "tailwindcss": "3.4.19",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "^8.12.4"
    },
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.11"
    },
    "@opencode-ai/plugin": {
      "zod": "^4.6.7"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.6"
    },
    "lodash-es": "^4.18.1",
    "tinypool": "^2.2.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "bunup@0.16.32": "patches/bunup@0.16.32.patch"
  }
}
