{
  "name": "pragma-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run --filter pragma tauri:dev",
    "dev:pragma": "bun run --filter pragma tauri:dev",
    "dev:www": "bun run --filter www dev",
    "dev:command": "bun scripts/dev-command.ts",
    "dev:go": "bun run --filter pragma-go start",
    "dev:go:ios": "bun run --filter pragma-go ios",
    "dev:go:android": "bun run --filter pragma-go android",
    "benchmark": "bun run --filter @pragma/bench start",
    "gateway:smoke": "bun scripts/gateway-sdk-smoke.ts",
    "plugins:lock": "bun run --filter @pragma/plugin-registry lock",
    "plugins:lock:local": "bun run --filter @pragma/plugin-registry lock:local",
    "plugins:validate": "bun run --filter @pragma/plugin-registry validate",
    "generate": "turbo run generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --workspace",
    "fallow:check": "fallow audit --base main --gate new-only --fail-on-issues",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run rust:fmt:check && bun run rust:clippy",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/design.md": "^0.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@tailwindcss/typography": "^0.5.20",
    "fallow": "^2.102.0",
    "husky": "^9.1.7",
    "json-schema-to-typescript": "^15.0.4",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "3.4.19",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "bunup@0.16.32": "patches/bunup@0.16.32.patch"
  }
}
