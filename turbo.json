{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "inputs": ["schema.json", "values.json"],
      "outputs": ["src/generated/**"]
    },
    "@pragma-sh/scratchpad-viewer#generate": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["src/generated/**"]
    },
    "@pragma-sh/code-viewer#generate": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["src/generated/**"]
    },
    "@pragma-sh/terminal-viewer#generate": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "schema.json", "values.json"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
