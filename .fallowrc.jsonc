{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // `scripts/run-shell-script.ts` is invoked from `apps/pragma/package.json`
  // via a parent-traversing relative path (`../../scripts/run-shell-script.ts`),
  // which fallow's per-workspace entry-point scan intentionally skips — hence
  // the explicit root-level entry here rather than relying on discovery.
  "entry": [
    "src/index.{js,jsx,ts,tsx,mjs}",
    "src/main.{js,jsx,ts,tsx,mjs}",
    "scripts/run-shell-script.ts",
  ],
  // Staged sidecar bundles under `src-tauri/resources/plugins/**` are build
  // artifacts (bunup output copied from analyzed source packages by
  // `stage-daemon-sidecar.sh`), not hand-written code. Analyzing them for
  // complexity double-counts the source and always estimates ~0 coverage
  // (bundling strips comments, so inline `fallow-ignore` never reaches them),
  // producing spurious CRAP findings. The source packages are analyzed directly.
  "ignorePatterns": ["apps/pragma/src-tauri/resources/plugins/**"],
  // `test-fixtures/**` plugin bundles are loaded at runtime (blob-URL dynamic
  // import by the plugin loader; path resolution by Rust tests), never
  // statically imported — they are not dead files.
  "dynamicallyLoaded": [
    "**/test-fixtures/**",
    // Plugin resource bundles loaded at runtime by the Rust sidecar launcher
    // (plugins.rs), never statically imported by any entry point.
    "**/resources/plugins/**",
  ],
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
  },
  // The shadcn/ui primitives in `components/ui` are our project's component
  // library: a deliberate, full-API surface kept in sync with `shadcn add`. An
  // unused variant we don't happen to render yet (e.g. some `Select*` parts) is
  // intentional public API, not dead code, so don't report unused exports there.
  // App code outside `ui/` is still held to the normal dead-code bar.
  "ignoreExports": [
    { "file": "**/components/ui/**", "exports": ["*"] },
    // `lib/tauri.ts` is the typed IPC boundary: every backend `#[tauri::command]`
    // gets exactly one named wrapper here so the app never touches raw command
    // strings (see the file header). A few wrappers mirror commands no UI calls
    // yet — that 1:1 contract is intentional, not dead code.
    { "file": "**/lib/tauri.ts", "exports": ["getAppInfo", "saveKeybindings", "aiLogout"] },
  ],
  // `@google/design.md` is the DesignSync CLI that generates DESIGN.md — a
  // tool invoked from the shell, intentionally never imported from source.
  // `expo-splash-screen` / `expo-system-ui` are Expo config-plugin / system deps
  // wired through `app.json` and the native runtime, never `import`ed from source,
  // so fallow's import scan can't see them.
  "ignoreDependencies": ["@google/design.md", "expo-splash-screen", "expo-system-ui"],
  // `@pragma/constants` imports generated TS types that may not exist before
  // `bun run generate`; don't report that intentional generated edge.
  "ignoreUnresolvedImports": ["./generated/constants"],
  "duplicates": {
    "mode": "semantic",
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    "ignore": [
      // shadcn/ui primitives are generated from a shared template, so the Radix
      // wrapper boilerplate (forwardRef + cn(className) + data-slot) repeats by
      // design across files. Refactoring it would fight the upstream generator
      // and the `shadcn add` workflow, so it's intentional duplication.
      "**/components/ui/**",
      // `lib/tauri.ts` is the typed IPC boundary (see the matching `ignoreExports`
      // entry above): every backend `#[tauri::command]` gets exactly one named
      // `invoke<T>("cmd", { args })` wrapper with its own JSDoc. That 1:1
      // boilerplate repeats by design — collapsing it into a factory would lose
      // the per-command typing and the explicit contract AGENTS.md mandates
      // ("Keep the IPC surface typed and centralized").
      "**/lib/tauri.ts",
      // Test suites repeat arrange/assert shapes by design (table-like cases
      // reading top-to-bottom). Semantic clone detection over them reports
      // idiomatic repetition, not copy-paste worth refactoring.
      "**/*.test.{ts,tsx}",
      // React/ReactDOM plugin shims must spell each host-bridge export out
      // individually for `isolatedDeclarations`; generated-looking one-line
      // exports are intentional API surface, not extractable logic.
      "packages/plugin/src/react*.ts",
      // The React Native Reusables theme in `global.css` is a design-token table:
      // light `:root` and dark `.dark:root` must declare the same `--token` names
      // with different values, so the property-name sequence repeats by design.
      // Deduping it would need a preprocessor and fight the RNR theming convention.
      "apps/pragma-mobile/global.css",
    ],
  },
  "rules": {
    "unused-component-props": "warn",
    "prop-drilling": "warn",
    "duplicate-prop-shape": "warn",
  },
}
