{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // `scripts/run-shell-script.ts` is invoked from `apps/pragma/package.json`
  // via a parent-traversing relative path (`../../scripts/run-shell-script.ts`),
  // which fallow's per-workspace entry-point scan intentionally skips — hence
  // the explicit root-level entry here rather than relying on discovery.
  "entry": [
    "src/index.{js,jsx,ts,tsx,mjs}",
    "src/main.{js,jsx,ts,tsx,mjs}",
    "scripts/run-shell-script.ts",
    // Same parent-traversing case: `apps/pragma`'s `web:stage` script runs it as
    // `../../scripts/stage-web-bundle.ts`.
    "scripts/stage-web-bundle.ts",
  ],
  // Staged sidecar bundles under `src-tauri/resources/plugins/**` are build
  // artifacts (bunup output copied from analyzed source packages by
  // `stage-daemon-sidecar.sh`), not hand-written code. Analyzing them for
  // complexity double-counts the source and always estimates ~0 coverage
  // (bundling strips comments, so inline `fallow-ignore` never reaches them),
  // producing spurious CRAP findings. The source packages are analyzed directly.
  "ignorePatterns": ["apps/pragma/src-tauri/resources/plugins/**"],
  // `test-fixtures/**` plugin bundles are loaded at runtime (blob-URL dynamic
  // import by the plugin loader; path resolution by Rust tests), never
  // statically imported — they are not dead files.
  "dynamicallyLoaded": [
    "**/test-fixtures/**",
    // Plugin resource bundles loaded at runtime by the Rust sidecar launcher
    // (plugins.rs), never statically imported by any entry point.
    "**/resources/plugins/**",
    // `packages/bench/src/runner.js` is pulled in via Rust `include_str!`
    // (scenarios.rs) and injected into the webview at runtime — never
    // statically imported by any JS/TS entry point.
    "packages/bench/src/runner.js",
    // The scratchpad viewer's in-page runtime is an esbuild entry point
    // (`packages/scratchpad-viewer/scripts/build.ts`) bundled into a string and
    // inlined into the generated document — never imported by a module graph.
    "packages/scratchpad-viewer/src/runtime/main.tsx",
    // Metro platform extensions: `apps/pragma-go` ships a `*.web.ts(x)` twin
    // beside each of these, and fallow's resolver follows the `.web` file — so
    // the native original looks unreachable even though it is exactly what an
    // iOS/Android build loads. Both halves are live code; only one of them is
    // visible to a single-platform module graph.
    "apps/pragma-go/components/RememberBrowserToggle.tsx",
    "apps/pragma-go/components/IconSymbol.tsx",
    "apps/pragma-go/components/scratchpad/ScratchpadWebView.tsx",
    "apps/pragma-go/components/ui/menu-view.tsx",
    "apps/pragma-go/lib/gateway-fetch.ts",
    "apps/pragma-go/lib/secret-store.ts",
    "apps/pragma-go/lib/web-handoff.ts",
    "apps/pragma-go/lib/widgets/use-widget-sync.ts",
    // Reachable only through `use-widget-sync.ts`, so it disappears with it.
    "apps/pragma-go/lib/widgets/widgets.tsx",
    // Documentation pages are discovered by Fumadocs from the `content/docs`
    // directory at build time (`defineDocs` in `apps/www/src/lib/source.ts`),
    // never statically imported.
    "apps/www/content/docs/**",
  ],
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
  },
  // The shadcn/ui primitives in `components/ui` are our project's component
  // library: a deliberate, full-API surface kept in sync with `shadcn add`. An
  // unused variant we don't happen to render yet (e.g. some `Select*` parts) is
  // intentional public API, not dead code, so don't report unused exports there.
  // App code outside `ui/` is still held to the normal dead-code bar.
  "ignoreExports": [
    { "file": "**/components/ui/**", "exports": ["*"] },
    // `lib/tauri.ts` is the typed IPC boundary: every backend `#[tauri::command]`
    // gets exactly one named wrapper here so the app never touches raw command
    // strings (see the file header). A few wrappers mirror commands no UI calls
    // yet — that 1:1 contract is intentional, not dead code.
    {
      "file": "**/lib/tauri.ts",
      "exports": ["getAppInfo", "saveKeybindings", "aiLogout"],
    },
    // Next.js App Router modules export a fixed framework contract — `default`,
    // `metadata`, `generateMetadata`, `generateStaticParams`, `revalidate`, and
    // the HTTP verbs. The router calls them by convention, so nothing imports
    // them and fallow sees every route file as dead exports.
    { "file": "apps/www/src/app/**", "exports": ["*"] },
    // `useMDXComponents` is the MDX provider hook resolved by name at compile
    // time by `@mdx-js/*`, not imported.
    { "file": "apps/www/src/components/mdx.tsx", "exports": ["useMDXComponents"] },
  ],
  // `@google/design.md` is the DesignSync CLI that generates DESIGN.md — a
  // tool invoked from the shell, intentionally never imported from source.
  // `expo-splash-screen` / `expo-system-ui` are Expo config-plugin / system deps
  // wired through `app.json` and the native runtime, never `import`ed from source,
  // so fallow's import scan can't see them.
  // `react-native-web` is never imported by name: Metro aliases `react-native`
  // to it for the web platform, so it is a build-time requirement fallow's
  // import scan cannot see.
  "ignoreDependencies": [
    "@google/design.md",
    "expo-splash-screen",
    "expo-system-ui",
    "react-native-web",
  ],
  // `@pragma/constants` imports generated TS types that may not exist before
  // `bun run generate`; don't report that intentional generated edge.
  // `@pragma/scratchpad/ui/primitives` is a real export in that package's
  // `exports` map (and resolves for tsc, Vite and Vitest); fallow's resolver
  // only handles single-segment subpaths, so it reports the nested one as
  // unresolved. Drop this entry once fallow resolves multi-segment subpaths.
  "ignoreUnresolvedImports": [
    "./generated/constants",
    "@pragma/scratchpad/ui/primitives",
    // Fumadocs resolves these package CSS entry points through Next's bundler,
    // but fallow's TypeScript resolver has no CSS package-resolution support.
    "fumadocs-ui/css/shadcn.css",
    "fumadocs-ui/css/preset.css",
  ],
  "duplicates": {
    "mode": "semantic",
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    "ignore": [
      // shadcn/ui primitives are generated from a shared template, so the Radix
      // wrapper boilerplate (forwardRef + cn(className) + data-slot) repeats by
      // design across files. Refactoring it would fight the upstream generator
      // and the `shadcn add` workflow, so it's intentional duplication.
      "**/components/ui/**",
      // `lib/tauri.ts` is the typed IPC boundary (see the matching `ignoreExports`
      // entry above): every backend `#[tauri::command]` gets exactly one named
      // `invoke<T>("cmd", { args })` wrapper with its own JSDoc. That 1:1
      // boilerplate repeats by design — collapsing it into a factory would lose
      // the per-command typing and the explicit contract AGENTS.md mandates
      // ("Keep the IPC surface typed and centralized").
      "**/lib/tauri.ts",
      // Test suites repeat arrange/assert shapes by design (table-like cases
      // reading top-to-bottom). Semantic clone detection over them reports
      // idiomatic repetition, not copy-paste worth refactoring.
      "**/*.test.{ts,tsx}",
      // React/ReactDOM plugin shims must spell each host-bridge export out
      // individually for `isolatedDeclarations`; generated-looking one-line
      // exports are intentional API surface, not extractable logic.
      "packages/plugin/src/react*.ts",
      // The React Native Reusables theme in `global.css` is a design-token table:
      // light `:root` and dark `.dark:root` must declare the same `--token` names
      // with different values, so the property-name sequence repeats by design.
      // Deduping it would need a preprocessor and fight the RNR theming convention.
      "apps/pragma-go/global.css",
      // These three share a 15-line *props preamble*: the tail of a props
      // interface followed by a component destructuring them, one per line and
      // alphabetically sorted because the linter sorts them. It is structure the
      // formatter produces, not logic that could be extracted. (Identical on
      // `main`; it only became visible when the app directory was renamed and
      // every file in it counted as changed.)
      "apps/pragma/src/components/command-palette/CommandPalette.tsx",
      "apps/pragma-go/app/chat/[tabId].tsx",
      "apps/pragma-go/components/InboxCard.tsx",
      // These three share a function parameter + inline prop-type preamble.
      // Their props and bodies differ, so extracting it provides no reusable logic.
      "apps/pragma/src/components/dialogs/CreateWorktreeDialog.tsx",
      "apps/pragma/src/components/settings/SettingsWorkspace.tsx",
      "apps/pragma/src/state/workspace-context.tsx",
      // Same story for the website's shadcn/ui token table: light `:root` and
      // dark `.dark` must declare the same `--token` names, and the block is
      // generated by `shadcn init`. It reads as a clone of the desktop app's
      // `index.css` because both start from the same shadcn base color, but the
      // two palettes are independent — the desktop one is a live token catalog
      // parsed at runtime by the theme system, the website's is static CSS.
      "apps/www/src/app/global.css",
    ],
  },
  "rules": {
    "unused-component-props": "warn",
    "prop-drilling": "warn",
    "duplicate-prop-shape": "warn",
  },
}
