{
  "name": "@pragma/github-helpers",
  "version": "0.0.0",
  "private": true,
  "description": "Host-side GitHub helpers for Pragma, compiled as the pragma-github sidecar.",
  "bin": {
    "pragma-github": "./src/cli.ts"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "build:sidecar": "bun build src/cli.ts --compile --minify --outfile dist/pragma-github"
  },
  "dependencies": {
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
