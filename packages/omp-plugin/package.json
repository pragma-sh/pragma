{
  "name": "@pragma-sh/omp-plugin",
  "version": "0.0.0",
  "description": "Oh My Pi (omp) extension and Pragma launcher built on the shared Pi integration.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pragma-sh/pragma.git",
    "directory": "packages/omp-plugin"
  },
  "files": [
    "assets",
    "dist",
    "pragma-plugin.json",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./pragma-plugin": "./dist/pragma-plugin.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/pragma-plugin.ts --outdir dist --format esm --target node --packages bundle --external '@oh-my-pi/*' && mv dist/index.js dist/index.mjs && mv dist/pragma-plugin.js dist/pragma-plugin.mjs",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@pragma-sh/pi-plugin": "workspace:*",
    "@pragma-sh/plugin": "workspace:*",
    "@pragma-sh/sdk": "workspace:*",
    "@types/node": "^24.12.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "omp": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "pragma": {
    "pluginId": "pragma.omp",
    "main": "./dist/pragma-plugin.mjs"
  }
}
