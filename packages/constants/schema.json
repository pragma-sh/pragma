{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constants",
  "description": "Shared compile-time constants. Single source of truth for both the TypeScript frontend (src) and the Rust backend (src-tauri). Edit values.json; never edit generated code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["maxParallelAgents", "app", "window", "links", "editorLaunchers", "daemon"],
  "properties": {
    "maxParallelAgents": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum number of agents Pragma runs in parallel. A single shared scalar constant used by both the TypeScript frontend and the Rust backend."
    },
    "app": { "$ref": "#/definitions/AppInfo" },
    "window": { "$ref": "#/definitions/WindowDefaults" },
    "links": { "$ref": "#/definitions/Links" },
    "editorLaunchers": { "$ref": "#/definitions/EditorLaunchers" },
    "daemon": { "$ref": "#/definitions/Daemon" }
  },
  "definitions": {
    "Daemon": {
      "title": "Daemon",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion"],
      "description": "Contract between the Pragma app and the detached PTY daemon.",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Wire-protocol version negotiated between the app and the detached PTY daemon. The daemon greets every connection with this version; the app replaces a daemon whose version does not match (or that sends no greeting). Bump it whenever the daemon protocol or its PTY-stream handling changes so a stale long-lived daemon is restarted instead of silently serving old behavior."
        }
      }
    },
    "AppInfo": {
      "title": "AppInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identifier", "version"],
      "properties": {
        "name": { "type": "string", "description": "Human-readable product name." },
        "identifier": { "type": "string", "description": "Reverse-DNS bundle identifier." },
        "version": { "type": "string", "description": "Semantic version string." }
      }
    },
    "WindowDefaults": {
      "title": "WindowDefaults",
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultWidth", "defaultHeight", "minWidth", "minHeight"],
      "properties": {
        "defaultWidth": { "type": "integer", "minimum": 1 },
        "defaultHeight": { "type": "integer", "minimum": 1 },
        "minWidth": { "type": "integer", "minimum": 1 },
        "minHeight": { "type": "integer", "minimum": 1 }
      }
    },
    "Links": {
      "title": "Links",
      "type": "object",
      "additionalProperties": false,
      "required": ["homepage", "support"],
      "properties": {
        "homepage": { "type": "string", "format": "uri" },
        "support": { "type": "string", "format": "uri" }
      }
    },
    "EditorLaunchers": {
      "title": "EditorLaunchers",
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultEditorId", "options"],
      "properties": {
        "defaultEditorId": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/definitions/EditorLauncher" }
        }
      }
    },
    "EditorLauncher": {
      "title": "EditorLauncher",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "brandIcon", "brandColor", "cliCommand"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brandIcon": {
          "type": "string",
          "description": "Iconify icon name, preferably from the simple-icons namespace for branded editors."
        },
        "brandColor": {
          "type": "string",
          "description": "Hex color used to render the monochrome Iconify brand glyph."
        },
        "cliCommand": {
          "type": ["string", "null"],
          "description": "Executable name used to launch the editor with the worktree path. Null uses the system file explorer."
        }
      }
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "orderIndex", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "orderIndex": { "type": "integer" },
        "createdAt": { "type": "string" }
      }
    },
    "Worktree": {
      "title": "Worktree",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "parentId",
        "branch",
        "title",
        "path",
        "isMain",
        "hidden",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "branch": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "path": { "type": "string" },
        "isMain": { "type": "boolean" },
        "hidden": {
          "type": "boolean",
          "description": "True when the user has hidden this worktree from the sidebar. Persists across restarts."
        },
        "createdAt": { "type": "string" }
      }
    },
    "TabKind": {
      "title": "TabKind",
      "description": "Discriminates what a tab hosts: a shell terminal, an embedded browser, a file editor, a read-only diff, or the read-only daemon log viewer.",
      "type": "string",
      "enum": ["terminal", "browser", "editor", "diff", "log"]
    },
    "AgentStatus": {
      "title": "AgentStatus",
      "description": "Runtime status an external agent reports for a terminal tab. `cleared` is a transient signal that removes the agent's indicator entirely (used when the agent process exits), as opposed to `done`, which leaves a green \"finished, go look\" dot.",
      "type": "string",
      "enum": ["running", "attention", "done", "cleared"]
    },
    "AgentReportKind": {
      "title": "AgentReportKind",
      "description": "CLI report command names; each maps to an AgentStatus.",
      "type": "string",
      "enum": ["started", "stopped", "attention", "cleared"]
    },
    "AgentAttentionKind": {
      "title": "AgentAttentionKind",
      "description": "Reason an agent needs the user's attention.",
      "type": "string",
      "enum": ["question", "command"]
    },
    "AgentReportPayload": {
      "title": "AgentReportPayload",
      "description": "Status report sent by pragma-agent through the daemon to the app.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "worktreeId", "tabId", "status"],
      "properties": {
        "agent": { "type": "string" },
        "worktreeId": { "type": "string" },
        "tabId": { "type": "string" },
        "status": { "$ref": "#/definitions/AgentStatus" },
        "attentionKind": {
          "anyOf": [{ "$ref": "#/definitions/AgentAttentionKind" }, { "type": "null" }]
        }
      }
    },
    "Tab": {
      "title": "Tab",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "worktreeId",
        "kind",
        "title",
        "url",
        "filePath",
        "diffSide",
        "userRenamed",
        "orderIndex",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "worktreeId": { "type": "string" },
        "kind": { "$ref": "#/definitions/TabKind" },
        "title": { "type": ["string", "null"] },
        "url": {
          "type": ["string", "null"],
          "description": "The current page URL for browser tabs; null for terminal tabs."
        },
        "filePath": {
          "type": ["string", "null"],
          "description": "Worktree-relative path for editor/diff tabs; null for terminal/browser tabs."
        },
        "diffSide": {
          "description": "Which diff side a diff tab shows; null for non-diff tabs.",
          "anyOf": [{ "$ref": "#/definitions/DiffSide" }, { "type": "null" }]
        },
        "userRenamed": {
          "type": "boolean",
          "description": "True once the user has manually renamed a terminal tab via double-click/context menu. Shell-emitted title updates (OSC 0/2) are ignored while this is true. Always false for non-terminal tabs."
        },
        "orderIndex": { "type": "integer" },
        "createdAt": { "type": "string" }
      }
    },
    "DirEntry": {
      "title": "DirEntry",
      "description": "A single entry in a worktree directory listing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "isDir"],
      "properties": {
        "name": { "type": "string", "description": "The entry's file name (no directory part)." },
        "path": {
          "type": "string",
          "description": "Worktree-relative POSIX path (forward slashes) to the entry."
        },
        "isDir": { "type": "boolean" }
      }
    },
    "DiffSide": {
      "title": "DiffSide",
      "description": "Which axis of change a diff tab shows: committed (base branch → HEAD), staged (HEAD → index), or unstaged (index → working tree).",
      "type": "string",
      "enum": ["committed", "staged", "unstaged"]
    },
    "ChangeStatus": {
      "title": "ChangeStatus",
      "description": "How a file changed relative to the diff base.",
      "type": "string",
      "enum": ["added", "modified", "deleted", "renamed", "untracked"]
    },
    "ChangedFile": {
      "title": "ChangedFile",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "oldPath", "status", "side", "additions", "deletions"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Worktree-relative POSIX path of the changed file."
        },
        "oldPath": {
          "type": ["string", "null"],
          "description": "Previous path for a rename; null otherwise."
        },
        "status": { "$ref": "#/definitions/ChangeStatus" },
        "side": { "$ref": "#/definitions/DiffSide" },
        "additions": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Lines added in this file's diff on its side. Null for binary files (git reports -/-) and for untracked files whose on-disk line count could not be determined."
        },
        "deletions": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Lines removed in this file's diff on its side. Null for binary files and for untracked files. 0 for untracked files (a brand-new file has nothing to remove)."
        }
      }
    },
    "WorktreeChanges": {
      "title": "WorktreeChanges",
      "type": "object",
      "additionalProperties": false,
      "required": ["committed", "staged", "unstaged"],
      "properties": {
        "committed": {
          "type": "array",
          "items": { "$ref": "#/definitions/ChangedFile" }
        },
        "staged": {
          "type": "array",
          "items": { "$ref": "#/definitions/ChangedFile" }
        },
        "unstaged": {
          "type": "array",
          "items": { "$ref": "#/definitions/ChangedFile" }
        }
      }
    },
    "FileDiff": {
      "title": "FileDiff",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "oldText", "newText", "binary"],
      "properties": {
        "path": { "type": "string" },
        "oldText": {
          "type": "string",
          "description": "The base-side text; empty when the file was added or is binary."
        },
        "newText": {
          "type": "string",
          "description": "The new-side text; empty when the file was deleted or is binary."
        },
        "binary": {
          "type": "boolean",
          "description": "True when git reports the file as binary; old/new text are empty."
        }
      }
    },
    "FileContents": {
      "title": "FileContents",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "text", "binary", "truncated", "byteSize"],
      "properties": {
        "path": { "type": "string" },
        "text": {
          "type": "string",
          "description": "The decoded UTF-8 text; empty when binary or truncated."
        },
        "binary": {
          "type": "boolean",
          "description": "True when the bytes are not valid UTF-8."
        },
        "truncated": {
          "type": "boolean",
          "description": "True when the file exceeds the read cap and was not read."
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0,
          "description": "On-disk size in bytes from the file metadata."
        }
      }
    },
    "ProjectIcon": {
      "title": "ProjectIcon",
      "type": "object",
      "additionalProperties": false,
      "required": ["mime", "dataBase64"],
      "properties": {
        "mime": { "type": "string" },
        "dataBase64": { "type": "string" }
      }
    },
    "WorktreeStatus": {
      "title": "WorktreeStatus",
      "description": "Status of a worktree's working copy, used to warn the user before destructive operations.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dirty"],
      "properties": {
        "dirty": {
          "type": "boolean",
          "description": "True when the worktree has uncommitted changes, staged changes, or untracked files that `git status` would surface."
        }
      }
    },
    "KeybindingChord": {
      "title": "KeybindingChord",
      "type": "object",
      "additionalProperties": false,
      "required": ["modifiers", "key"],
      "properties": {
        "modifiers": {
          "type": "array",
          "items": { "type": "string", "enum": ["cmd", "ctrl", "alt", "shift"] }
        },
        "key": { "type": "string" }
      }
    },
    "PlatformChord": {
      "title": "PlatformChord",
      "type": "object",
      "additionalProperties": false,
      "required": ["mac", "linux"],
      "properties": {
        "mac": { "$ref": "#/definitions/KeybindingChord" },
        "linux": { "$ref": "#/definitions/KeybindingChord" }
      }
    },
    "Keybindings": {
      "title": "Keybindings",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nextTab",
        "previousTab",
        "closeTopTab",
        "newTerminalTab",
        "newBrowserTab",
        "clearTerminal",
        "browserReload",
        "browserDevtools",
        "browserCopyUrl",
        "splitHorizontal",
        "splitVertical",
        "deleteFile",
        "scrollTerminalBottom",
        "switchToWorkspace1",
        "switchToWorkspace2",
        "switchToWorkspace3",
        "switchToWorkspace4",
        "switchToWorkspace5",
        "switchToWorkspace6",
        "switchToWorkspace7",
        "switchToWorkspace8",
        "switchToWorkspace9"
      ],
      "properties": {
        "nextTab": { "$ref": "#/definitions/PlatformChord" },
        "previousTab": { "$ref": "#/definitions/PlatformChord" },
        "closeTopTab": { "$ref": "#/definitions/PlatformChord" },
        "newTerminalTab": { "$ref": "#/definitions/PlatformChord" },
        "newBrowserTab": { "$ref": "#/definitions/PlatformChord" },
        "clearTerminal": { "$ref": "#/definitions/PlatformChord" },
        "browserReload": { "$ref": "#/definitions/PlatformChord" },
        "browserDevtools": { "$ref": "#/definitions/PlatformChord" },
        "browserCopyUrl": { "$ref": "#/definitions/PlatformChord" },
        "splitHorizontal": { "$ref": "#/definitions/PlatformChord" },
        "splitVertical": { "$ref": "#/definitions/PlatformChord" },
        "deleteFile": { "$ref": "#/definitions/PlatformChord" },
        "scrollTerminalBottom": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace1": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace2": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace3": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace4": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace5": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace6": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace7": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace8": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace9": { "$ref": "#/definitions/PlatformChord" }
      }
    },
    "KeybindingsConfig": {
      "title": "KeybindingsConfig",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "bindings"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "bindings": { "$ref": "#/definitions/Keybindings" }
      }
    }
  }
}
