{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constants",
  "description": "Shared compile-time constants. Single source of truth for both the TypeScript frontend (src) and the Rust backend (src-tauri). Edit values.json; never edit generated code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["maxParallelAgents", "app", "window", "links", "editorLaunchers"],
  "properties": {
    "maxParallelAgents": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum number of agents Pragma runs in parallel. A single shared scalar constant used by both the TypeScript frontend and the Rust backend."
    },
    "app": { "$ref": "#/definitions/AppInfo" },
    "window": { "$ref": "#/definitions/WindowDefaults" },
    "links": { "$ref": "#/definitions/Links" },
    "editorLaunchers": { "$ref": "#/definitions/EditorLaunchers" }
  },
  "definitions": {
    "AppInfo": {
      "title": "AppInfo",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identifier", "version"],
      "properties": {
        "name": { "type": "string", "description": "Human-readable product name." },
        "identifier": { "type": "string", "description": "Reverse-DNS bundle identifier." },
        "version": { "type": "string", "description": "Semantic version string." }
      }
    },
    "WindowDefaults": {
      "title": "WindowDefaults",
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultWidth", "defaultHeight", "minWidth", "minHeight"],
      "properties": {
        "defaultWidth": { "type": "integer", "minimum": 1 },
        "defaultHeight": { "type": "integer", "minimum": 1 },
        "minWidth": { "type": "integer", "minimum": 1 },
        "minHeight": { "type": "integer", "minimum": 1 }
      }
    },
    "Links": {
      "title": "Links",
      "type": "object",
      "additionalProperties": false,
      "required": ["homepage", "support"],
      "properties": {
        "homepage": { "type": "string", "format": "uri" },
        "support": { "type": "string", "format": "uri" }
      }
    },
    "EditorLaunchers": {
      "title": "EditorLaunchers",
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultEditorId", "options"],
      "properties": {
        "defaultEditorId": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/definitions/EditorLauncher" }
        }
      }
    },
    "EditorLauncher": {
      "title": "EditorLauncher",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "brandIcon", "brandColor", "cliCommand"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brandIcon": {
          "type": "string",
          "description": "Iconify icon name, preferably from the simple-icons namespace for branded editors."
        },
        "brandColor": {
          "type": "string",
          "description": "Hex color used to render the monochrome Iconify brand glyph."
        },
        "cliCommand": {
          "type": ["string", "null"],
          "description": "Executable name used to launch the editor with the worktree path. Null uses the system file explorer."
        }
      }
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "orderIndex", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "orderIndex": { "type": "integer" },
        "createdAt": { "type": "string" }
      }
    },
    "Worktree": {
      "title": "Worktree",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "parentId",
        "branch",
        "title",
        "path",
        "isMain",
        "hidden",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "branch": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "path": { "type": "string" },
        "isMain": { "type": "boolean" },
        "hidden": {
          "type": "boolean",
          "description": "True when the user has hidden this worktree from the sidebar. Persists across restarts."
        },
        "createdAt": { "type": "string" }
      }
    },
    "TabKind": {
      "title": "TabKind",
      "description": "Discriminates what a tab hosts: a shell terminal or an embedded browser.",
      "type": "string",
      "enum": ["terminal", "browser"]
    },
    "Tab": {
      "title": "Tab",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "worktreeId",
        "kind",
        "title",
        "url",
        "orderIndex",
        "createdAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "worktreeId": { "type": "string" },
        "kind": { "$ref": "#/definitions/TabKind" },
        "title": { "type": ["string", "null"] },
        "url": {
          "type": ["string", "null"],
          "description": "The current page URL for browser tabs; null for terminal tabs."
        },
        "orderIndex": { "type": "integer" },
        "createdAt": { "type": "string" }
      }
    },
    "ProjectIcon": {
      "title": "ProjectIcon",
      "type": "object",
      "additionalProperties": false,
      "required": ["mime", "dataBase64"],
      "properties": {
        "mime": { "type": "string" },
        "dataBase64": { "type": "string" }
      }
    },
    "WorktreeStatus": {
      "title": "WorktreeStatus",
      "description": "Status of a worktree's working copy, used to warn the user before destructive operations.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dirty"],
      "properties": {
        "dirty": {
          "type": "boolean",
          "description": "True when the worktree has uncommitted changes, staged changes, or untracked files that `git status` would surface."
        }
      }
    },
    "KeybindingChord": {
      "title": "KeybindingChord",
      "type": "object",
      "additionalProperties": false,
      "required": ["modifiers", "key"],
      "properties": {
        "modifiers": {
          "type": "array",
          "items": { "type": "string", "enum": ["cmd", "ctrl", "alt", "shift"] }
        },
        "key": { "type": "string" }
      }
    },
    "PlatformChord": {
      "title": "PlatformChord",
      "type": "object",
      "additionalProperties": false,
      "required": ["mac", "linux"],
      "properties": {
        "mac": { "$ref": "#/definitions/KeybindingChord" },
        "linux": { "$ref": "#/definitions/KeybindingChord" }
      }
    },
    "Keybindings": {
      "title": "Keybindings",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nextTab",
        "previousTab",
        "closeTopTab",
        "newTerminalTab",
        "newBrowserTab",
        "clearTerminal",
        "browserReload",
        "browserDevtools",
        "browserCopyUrl",
        "switchToWorkspace1",
        "switchToWorkspace2",
        "switchToWorkspace3",
        "switchToWorkspace4",
        "switchToWorkspace5",
        "switchToWorkspace6",
        "switchToWorkspace7",
        "switchToWorkspace8",
        "switchToWorkspace9"
      ],
      "properties": {
        "nextTab": { "$ref": "#/definitions/PlatformChord" },
        "previousTab": { "$ref": "#/definitions/PlatformChord" },
        "closeTopTab": { "$ref": "#/definitions/PlatformChord" },
        "newTerminalTab": { "$ref": "#/definitions/PlatformChord" },
        "newBrowserTab": { "$ref": "#/definitions/PlatformChord" },
        "clearTerminal": { "$ref": "#/definitions/PlatformChord" },
        "browserReload": { "$ref": "#/definitions/PlatformChord" },
        "browserDevtools": { "$ref": "#/definitions/PlatformChord" },
        "browserCopyUrl": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace1": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace2": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace3": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace4": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace5": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace6": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace7": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace8": { "$ref": "#/definitions/PlatformChord" },
        "switchToWorkspace9": { "$ref": "#/definitions/PlatformChord" }
      }
    },
    "KeybindingsConfig": {
      "title": "KeybindingsConfig",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "bindings"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "bindings": { "$ref": "#/definitions/Keybindings" }
      }
    }
  }
}
