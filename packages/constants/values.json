{
  "daemon": {
    "protocolVersion": 21,
    "socketFile": "daemon.sock",
    "lockFile": "server.lock",
    "logFile": "server.log"
  },
  "gateway": {
    "discoveryFile": "gateway.json",
    "tokenFile": "gateway-token",
    "devicesFile": "gateway-devices.json",
    "tokenHeader": "authorization",
    "deviceHeaders": {
      "id": "x-pragma-device-id",
      "name": "x-pragma-device-name",
      "platform": "x-pragma-device-platform",
      "appVersion": "x-pragma-app-version"
    }
  },
  "platform": {
    "defaultBackend": "native",
    "shells": {
      "macos": "/bin/zsh",
      "linux": "/bin/sh",
      "windows": ["pwsh.exe", "powershell.exe"]
    },
    "wsl": {
      "launcher": "wsl.exe",
      "listArgs": ["--list", "--verbose"],
      "serverBinary": "pragma-server"
    }
  },
  "tunnel": {
    "defaultCommand": "ngrok http {port} --log stdout --log-format json",
    "defaultUrlPattern": "(https://[^\\s\"]+)"
  },
  "plugins": {
    "configFileName": ".pragma/config.json",
    "storageScopes": ["global", "project"],
    "bundledDirName": "plugins"
  },
  "theme": {
    "fileName": ".pragma/theme.json",
    "modes": ["light", "dark"]
  },
  "keybindings": {
    "configFileName": ".pragma/keybindings.json"
  },
  "bench": {
    "hookGlobal": "__PRAGMA_BENCH__",
    "runnerGlobal": "__PRAGMA_BENCH_RUNNER__",
    "markerPrefix": "PRAGMABENCH",
    "tabTitle": "pragma-bench"
  },
  "agentStatus": {
    "soundsDirName": ".pragma/assets/sounds",
    "maxSoundSeconds": 5,
    "maxSoundBytes": 5242880,
    "soundExtensions": ["mp3", "wav", "ogg", "oga", "m4a", "aac", "flac", "webm"],
    "notificationsEnabled": true
  },
  "files": {
    "chunkBytes": 4194304,
    "maxBinaryBytes": 268435456
  },
  "protocol": {
    "rpcMethods": [
      "git",
      "filesystem",
      "database",
      "kanban",
      "worktrees",
      "projects",
      "tabs",
      "settings",
      "github",
      "ai",
      "exec",
      "automations",
      "plugins",
      "tunnel"
    ],
    "events": [
      "agentStatus",
      "worktreeChanged",
      "kanbanChanged",
      "tabsChanged",
      "fileChanged",
      "echoMode",
      "automationPending",
      "automationsChanged",
      "workspace"
    ],
    "errors": [
      "invalidPayload",
      "unsupportedMethod",
      "notFound",
      "staleWrite",
      "permissionDenied",
      "internal"
    ]
  },
  "scripts": {
    "maxConcurrentCommands": 4,
    "configPath": ".pragma/scripts.json"
  },
  "agents": {
    "startDelayMs": 500,
    "altScreenExtraWaitMs": 15000,
    "altScreenSettleMs": 500
  },
  "github": {
    "oauthClientId": "Ov23li1WfY05SeQNp5tk",
    "scopes": ["repo"],
    "deviceCodeUrl": "https://github.com/login/device/code",
    "deviceVerifyUrl": "https://github.com/login/device",
    "accessTokenUrl": "https://github.com/login/oauth/access_token",
    "apiBaseUrl": "https://api.github.com"
  },
  "app": {
    "name": "Pragma",
    "identifier": "com.pragma.app",
    "version": "0.0.0"
  },
  "window": {
    "defaultWidth": 1024,
    "defaultHeight": 768,
    "minWidth": 640,
    "minHeight": 480,
    "titlebarHeight": 38,
    "trafficLightInset": 12
  },
  "links": {
    "homepage": "https://pragma.example.com",
    "support": "https://pragma.example.com/support"
  },
  "editorLaunchers": {
    "defaultEditorId": "system",
    "options": [
      {
        "id": "system",
        "name": "File Explorer",
        "brandIcon": "lucide:folder-open",
        "brandColor": "#38bdf8",
        "cliCommand": null
      },
      {
        "id": "vscode",
        "name": "VS Code",
        "brandIcon": "simple-icons:visualstudiocode",
        "brandColor": "#007acc",
        "cliCommand": "code"
      },
      {
        "id": "cursor",
        "name": "Cursor",
        "brandIcon": "simple-icons:cursor",
        "brandColor": "#ffffff",
        "cliCommand": "cursor"
      },
      {
        "id": "windsurf",
        "name": "Windsurf",
        "brandIcon": "simple-icons:windsurf",
        "brandColor": "#00c7be",
        "cliCommand": "windsurf"
      },
      {
        "id": "zed",
        "name": "Zed",
        "brandIcon": "simple-icons:zedindustries",
        "brandColor": "#084ccf",
        "cliCommand": "zed"
      },
      {
        "id": "sublime-text",
        "name": "Sublime Text",
        "brandIcon": "simple-icons:sublimetext",
        "brandColor": "#ff9800",
        "cliCommand": "subl"
      },
      {
        "id": "intellij-idea",
        "name": "IntelliJ IDEA",
        "brandIcon": "simple-icons:intellijidea",
        "brandColor": "#ff2d8f",
        "cliCommand": "idea"
      }
    ]
  }
}
