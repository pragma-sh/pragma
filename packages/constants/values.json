{
  "maxParallelAgents": 8,
  "daemon": {
    "protocolVersion": 9
  },
  "gateway": {
    "discoveryFile": "gateway.json",
    "tokenHeader": "authorization"
  },
  "plugins": {
    "configFileName": ".pragma/config.json",
    "storageScopes": ["global", "project"]
  },
  "protocol": {
    "rpcMethods": [
      "git",
      "filesystem",
      "database",
      "kanban",
      "worktrees",
      "projects",
      "tabs",
      "settings",
      "github",
      "ai",
      "exec",
      "automations"
    ],
    "events": [
      "agentStatus",
      "worktreeChanged",
      "kanbanChanged",
      "tabsChanged",
      "fileChanged",
      "echoMode",
      "automationPending",
      "automationsChanged"
    ],
    "errors": [
      "invalidPayload",
      "unsupportedMethod",
      "notFound",
      "staleWrite",
      "permissionDenied",
      "internal"
    ]
  },
  "scripts": {
    "maxConcurrentCommands": 4
  },
  "agents": {
    "startDelayMs": 500
  },
  "github": {
    "oauthClientId": "Ov23li1WfY05SeQNp5tk",
    "scopes": ["repo"],
    "deviceCodeUrl": "https://github.com/login/device/code",
    "deviceVerifyUrl": "https://github.com/login/device",
    "accessTokenUrl": "https://github.com/login/oauth/access_token",
    "apiBaseUrl": "https://api.github.com"
  },
  "app": {
    "name": "Pragma",
    "identifier": "com.pragma.app",
    "version": "0.0.0"
  },
  "window": {
    "defaultWidth": 1024,
    "defaultHeight": 768,
    "minWidth": 640,
    "minHeight": 480,
    "titlebarHeight": 38,
    "trafficLightInset": 12
  },
  "links": {
    "homepage": "https://pragma.example.com",
    "support": "https://pragma.example.com/support"
  },
  "editorLaunchers": {
    "defaultEditorId": "system",
    "options": [
      {
        "id": "system",
        "name": "File Explorer",
        "brandIcon": "lucide:folder-open",
        "brandColor": "#38bdf8",
        "cliCommand": null
      },
      {
        "id": "vscode",
        "name": "VS Code",
        "brandIcon": "simple-icons:visualstudiocode",
        "brandColor": "#007acc",
        "cliCommand": "code"
      },
      {
        "id": "cursor",
        "name": "Cursor",
        "brandIcon": "simple-icons:cursor",
        "brandColor": "#ffffff",
        "cliCommand": "cursor"
      },
      {
        "id": "windsurf",
        "name": "Windsurf",
        "brandIcon": "simple-icons:windsurf",
        "brandColor": "#00c7be",
        "cliCommand": "windsurf"
      },
      {
        "id": "zed",
        "name": "Zed",
        "brandIcon": "simple-icons:zedindustries",
        "brandColor": "#084ccf",
        "cliCommand": "zed"
      },
      {
        "id": "sublime-text",
        "name": "Sublime Text",
        "brandIcon": "simple-icons:sublimetext",
        "brandColor": "#ff9800",
        "cliCommand": "subl"
      },
      {
        "id": "intellij-idea",
        "name": "IntelliJ IDEA",
        "brandIcon": "simple-icons:intellijidea",
        "brandColor": "#ff2d8f",
        "cliCommand": "idea"
      }
    ]
  }
}
