{
  "name": "@pragma/opencode-plugin",
  "version": "0.0.0",
  "description": "opencode plugin that reports agent status to Pragma automatically.",
  "files": [
    "assets",
    "dist",
    "pragma"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./pragma-watcher": {
      "types": "./dist/pragma-watcher.d.ts",
      "import": "./dist/pragma-watcher.mjs"
    },
    "./pragma-agent": "./src/pragma-agent.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "bun run --filter @pragma/sdk build && bun run --filter @pragma/plugin build",
    "build": "bunup src/index.ts src/pragma-watcher.ts --format esm --target node --dts --packages bundle && mv dist/index.js dist/index.mjs && mv dist/pragma-watcher.js dist/pragma-watcher.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun --bun vitest run",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@pragma/sdk": "workspace:*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.8",
    "@pragma/plugin": "workspace:*",
    "@types/node": "^24.12.3",
    "bunup": "^0.16.32",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
