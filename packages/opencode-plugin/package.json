{
  "name": "@pragma/opencode-plugin",
  "version": "0.0.0",
  "description": "opencode plugin that reports agent status to Pragma automatically.",
  "files": [
    "assets",
    "dist",
    "pragma"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "bun run --filter @pragma/sdk build",
    "build": "bunup src/index.ts --format esm --target node --dts --packages bundle && mv dist/index.js dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@pragma/sdk": "workspace:*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.8",
    "@types/node": "^24.12.3",
    "bunup": "^0.16.32",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
