{
  "name": "@pragma/automations",
  "version": "0.0.0",
  "private": true,
  "description": "Pragma automation authoring API and host sidecar runtime.",
  "bin": {
    "pragma-automations": "./src/cli.ts"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "lint": "oxlint .",
    "build:sidecar": "bun build src/cli.ts --compile --minify --outfile dist/pragma-automations"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
