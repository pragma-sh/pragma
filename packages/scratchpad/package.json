{
  "name": "@pragma-sh/scratchpad",
  "version": "0.4.0",
  "description": "Interactive runtime and UI components for Pragma scratchpads.",
  "homepage": "https://github.com/pragma-sh/pragma#readme",
  "bugs": "https://github.com/pragma-sh/pragma/issues",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pragma-sh/pragma.git",
    "directory": "packages/scratchpad"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./ui/primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "require": "./dist/primitives.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun --bun vitest run",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@pragma-sh/sdk": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "bunup": "^0.16.32",
    "react": "^19.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
