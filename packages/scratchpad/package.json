{
  "name": "@pragma/scratchpad",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive runtime and UI components for Pragma scratchpads.",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./ui/primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "require": "./dist/primitives.cjs"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "pretest": "bun run build",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun --bun vitest run",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@pragma/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "bunup": "^0.16.32",
    "react": "^19.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
