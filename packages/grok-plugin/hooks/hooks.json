{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" cleared",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" started",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" stopped",
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" failed",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" subagent-stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_user_question",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" question",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" running",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" running",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/report.sh\" cleared",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
