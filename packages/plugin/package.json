{
  "name": "@pragma/plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Public TypeScript API for building Pragma plugins.",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react-dom": {
      "types": "./dist/react-dom.d.ts",
      "import": "./dist/react-dom.js",
      "require": "./dist/react-dom.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js",
      "require": "./dist/version.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "bun scripts/generate-version.ts",
    "prebuild": "bun run generate",
    "build": "bunup src/index.ts src/react.ts src/react-dom.ts src/jsx-runtime.ts src/ui.ts src/icons.ts src/version.ts --format esm,cjs --target browser --dts",
    "pretypecheck": "bun run generate",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "pretest": "bun run generate",
    "test": "bun --bun vitest run",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@pragma/constants": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bunup": "^0.16.32",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
