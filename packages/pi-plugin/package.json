{
  "name": "@pragma-sh/pi-plugin",
  "version": "0.1.0-alpha.0",
  "description": "Pi CLI extension that reports agent status to Pragma.",
  "license": "AGPL-3.0-only",
  "files": [
    "assets",
    "dist",
    "pragma-plugin.json",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./extension-factory": {
      "types": "./src/extension-factory.ts",
      "default": "./dist/extension-factory.mjs"
    },
    "./pragma-plugin": "./dist/pragma-plugin.mjs",
    "./pragma-plugin-factory": {
      "types": "./src/pragma-plugin-factory.ts",
      "default": "./dist/pragma-plugin-factory.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/extension-factory.ts src/pragma-plugin.ts src/pragma-plugin-factory.ts --outdir dist --format esm --target node --packages bundle && for file in dist/*.js; do mv \"$file\" \"${file%.js}.mjs\"; done",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@pragma/plugin": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "@pragma/watcher-kit": "workspace:*",
    "@types/node": "^24.12.3",
    "bunup": "^0.16.32",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "pragma": {
    "pluginId": "pragma.pi",
    "main": "./dist/pragma-plugin.mjs"
  }
}
