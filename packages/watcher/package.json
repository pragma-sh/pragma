{
  "name": "@pragma/watcher",
  "version": "0.0.0",
  "private": true,
  "description": "Host-side watcher sidecar for Pragma plugin defineWatcher contributions.",
  "bin": {
    "pragma-watch": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run --passWithNoTests",
    "lint": "oxlint .",
    "build:sidecar": "bun build src/cli.ts --compile --minify --outfile dist/pragma-watch"
  },
  "dependencies": {
    "@pragma/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
