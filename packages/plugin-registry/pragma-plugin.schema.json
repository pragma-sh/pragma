{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PragmaPluginManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "install"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "longDescription": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["agent-plugin", "theme", "general"] }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "alt"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "alt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "agentBinary": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" }
  }
}
