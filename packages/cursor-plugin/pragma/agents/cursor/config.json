{
  "id": "cursor",
  "name": "Cursor Agent",
  "icon": "icon.svg",
  "start": ["agent", "--force", "--approve-mcps"],
  "startupInput": [{ "delayMs": 5000, "data": "a" }],
  "prefillDelayMs": 14000,
  "prefillMode": "plain",
  "prefillSubmit": "\r",
  "models": {
    "source": "command",
    "command": ["sh", "scripts/list-models.sh"],
    "modelArg": ["--model", "{model}"],
    "modelReasoningArg": ["--model", "{model}[effort={reasoning}]"]
  }
}
