{
  "expo": {
    "name": "Pragma Go",
    "slug": "pragma-go",
    "scheme": "pragma",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f3c3210c-7991-427e-a088-c63e63c81a73",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/AppIcon.icon",
      "bundleIdentifier": "sh.pragma.go",
      "infoPlist": {
        "CFBundleDisplayName": "Pragma Go",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Pragma Go connects to the Pragma desktop app on your computer, which may be on the same local network."
      },
      "buildNumber": "5"
    },
    "android": {
      "package": "sh.pragma.go",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#0b0b0c"
      },
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Pragma Go uses the camera to scan the pairing QR code shown by the Pragma desktop app.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "./plugins/with-android-splash-logo.ts",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0b0b0c"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PragmaAttention",
              "displayName": "Needs Attention",
              "description": "How many agents are waiting on you.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "PragmaAgents",
              "displayName": "Agent Status",
              "description": "Agents working, needing attention, and done.",
              "ios": {
                "supportedFamilies": ["systemMedium"]
              }
            },
            {
              "name": "PragmaInbox",
              "displayName": "Inbox",
              "description": "The approvals and questions waiting for a decision.",
              "ios": {
                "supportedFamilies": ["systemMedium", "systemLarge"]
              }
            },
            {
              "name": "PragmaProjects",
              "displayName": "Projects",
              "description": "Agent status rolled up per project.",
              "ios": {
                "supportedFamilies": ["systemMedium", "systemLarge"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3c3210c-7991-427e-a088-c63e63c81a73"
      }
    },
    "owner": "ekrich"
  }
}
