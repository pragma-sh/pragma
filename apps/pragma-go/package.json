  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/culori": "^4.0.1",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.0",
    "vitest": "^4.1.8"
  }
