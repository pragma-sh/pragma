{
  "name": "pragma-go",
  "version": "1.0.0",
  "private": true,
  "description": "Pragma Go — Expo client for Pragma worktrees on phone, tablet, and web",
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "preexport:web": "bunx turbo run build --filter=pragma-go^...",
    "export:web": "EXPO_BASE_URL=/web expo export --platform web --output-dir dist",
    "prebuild": "expo prebuild",
    "update": "PRAGMA_STORE_BUILD=1 eas update --branch production --platform all",
    "icons": "bun run scripts/generate-icons.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "expo lint",
    "eas-build-post-install": "bun x turbo run build --filter=pragma-go^..."
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.18",
    "@expo/ui": "~57.0.26",
    "@pragma-sh/accounts-view": "workspace:*",
    "@pragma-sh/brand": "workspace:*",
    "@pragma-sh/code-viewer": "workspace:*",
    "@pragma-sh/constants": "workspace:*",
    "@pragma-sh/fanout-view": "workspace:*",
    "@pragma-sh/scratchpad-viewer": "workspace:*",
    "@pragma-sh/sdk": "workspace:*",
    "@pragma-sh/terminal-viewer": "workspace:*",
    "@react-native-menu/menu": "^2.0.0",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "expo": "^57.0.32",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "^57.0.2",
    "expo-constants": "~57.0.23",
    "expo-dev-client": "^57.0.21",
    "expo-glass-effect": "~57.0.5",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "^57.0.27",
    "expo-widgets": "~57.0.28",
    "lucide-react": "^1.70.0",
    "nativewind": "^4.2.7",
    "prismjs": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-marked": "^8.3.4",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@expo/ngrok": "^4.1.3",
    "@types/culori": "^4.0.1",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.17",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
