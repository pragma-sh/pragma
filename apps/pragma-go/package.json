{
  "name": "pragma-go",
  "version": "0.0.0",
  "private": true,
  "description": "Pragma Go — Expo client for Pragma worktrees on phone, tablet, and web",
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "EXPO_BASE_URL=/web expo export --platform web --output-dir dist",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/ui": "~57.0.8",
    "@pragma/constants": "workspace:*",
    "@pragma/scratchpad-viewer": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "@react-native-menu/menu": "^2.0.0",
    "@rn-primitives/portal": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "expo": "^57.0.2",
    "expo-camera": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-glass-effect": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-widgets": "~57.0.7",
    "lucide-react": "^1.31.0",
    "nativewind": "^4.2.6",
    "prismjs": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-marked": "^8.1.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "^3.6.0"
