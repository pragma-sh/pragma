<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX fragment: stop Pragma's processes before the MSI touches their files.

  The MSI counterpart to `installer-hooks.nsh`, and it exists for the same
  reason: Pragma deliberately detaches a persistent `pragma-server` (it owns the
  terminal sessions, so it outlives the window), a `pragma-gateway`, and the
  sidecars listed under `bundle.externalBin`. Windows locks a running
  executable's image file, so an install over a live instance cannot replace
  them.

  The MSI installs `perMachine` into Program Files rather than AppData, so the
  path in the failure differs from the NSIS one, but the lock is identical.
  Left alone, MSI falls back on Restart Manager, which handles a windowed app
  well and a headless background process badly: the usual outcome is a "files in
  use" dialog it cannot satisfy, then a reboot demand. `RebootPrompt="no"` plus
  an explicit terminate is what avoids that.

  Keep the list in step with `bundle.externalBin`; `installer-hooks.test.ts`
  fails if this file, the NSIS hook, and `externalBin` drift apart.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <!--
      A WiX fragment is linked only if something references it. This group is
      empty on purpose: `wix.componentGroupRefs` in tauri.conf.json names it,
      which resolves a symbol in this fragment and so pulls in every
      `util:CloseApplication` below with it. Renaming it means renaming it
      there too.
    -->
    <ComponentGroup Id="PragmaCloseApplications" />

    <!--
      The app must be listed first. `WixCloseApplication` has no sequence
      column, so the deferred action terminates these in table order, and the
      app restarts the server and gateway as soon as it notices them gone
      (`ensure_gateway_in_background`, and the agent-event bridge's reconnect
      loop). Killing it first is what stops a respawn from re-locking a file.

      `CloseMessage` asks politely with WM_CLOSE first; it only does anything
      for the one process here that owns a window. `TerminateProcess` is what
      handles the rest. The deferred action runs elevated, so terminating a
      user's process from a perMachine install works.
    -->
    <util:CloseApplication Id="ClosePragma"
                           Target="pragma.exe"
                           CloseMessage="yes"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="ClosePragmaServer"
                           Target="pragma-server.exe"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="ClosePragmaGateway"
                           Target="pragma-gateway.exe"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="ClosePragmaCli"
                           Target="pragma-cli.exe"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="ClosePragmaAi"
                           Target="pragma-ai.exe"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="ClosePragmaGithub"
                           Target="pragma-github.exe"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="ClosePragmaWatch"
                           Target="pragma-watch.exe"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="ClosePragmaAutomations"
                           Target="pragma-automations.exe"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="ClosePragmaPlugins"
                           Target="pragma-plugins.exe"
                           TerminateProcess="0"
                           RebootPrompt="no" />
  </Fragment>
</Wix>
