{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pragma",
  "version": "0.0.0",
  "identifier": "com.pragma.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build && bun run sidecar:server:release"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Pragma",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pragma"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage"],
    "externalBin": [
      "binaries/pragma-server",
      "binaries/pragma-gateway",
      "binaries/pragma-cli",
      "binaries/pragma-ai",
      "binaries/pragma-github",
      "binaries/pragma-watch"
    ],
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
