{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src"],
  // Benchmarks write their results to disk, so they need Node types the app
  // itself must not have. They are typechecked by tsconfig.node.json instead.
  "exclude": ["src/**/*.bench.ts"]
}
