{
  "name": "pragma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "predev": "bun run --filter @pragma/constants generate && bun run --filter @pragma/scratchpad build && bun run --filter @pragma/scratchpad-viewer build",
    "prebuild": "bun run --filter @pragma/constants generate && bun run --filter @pragma/sdk build && bun run --filter @pragma/plugin build && bun run --filter @pragma/scratchpad build && bun run --filter @pragma/scratchpad-viewer build",
    "typecheck": "tsc -b --noEmit",
    "test": "bun --bun vitest run",
    "lint": "oxlint .",
    "tauri": "tauri",
    "sidecar:server": "bun ../../scripts/run-shell-script.ts src-tauri/scripts/stage-daemon-sidecar.sh",
    "sidecar:server:release": "bun ../../scripts/run-shell-script.ts src-tauri/scripts/stage-daemon-sidecar.sh --release",
    "plugins:refresh": "bun ../../scripts/run-shell-script.ts src-tauri/scripts/stage-bundled-plugins.sh",
    "web:stage": "bun ../../scripts/stage-web-bundle.ts",
    "tauri:dev": "bunx turbo run build --filter @pragma/dev-test-plugin && bun run sidecar:server && bun run web:stage && tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@embedpdf/core": "^2.14.4",
    "@embedpdf/engines": "^2.14.4",
    "@embedpdf/models": "^2.14.4",
    "@embedpdf/pdfium": "^2.14.4",
    "@embedpdf/plugin-document-manager": "^2.14.4",
    "@embedpdf/plugin-interaction-manager": "^2.14.4",
    "@embedpdf/plugin-render": "^2.14.4",
    "@embedpdf/plugin-scroll": "^2.14.4",
    "@embedpdf/plugin-selection": "^2.14.4",
    "@embedpdf/plugin-viewport": "^2.14.4",
    "@embedpdf/plugin-zoom": "^2.14.4",
    "@iconify-json/vscode-icons": "^1.2.57",
    "@iconify/react": "^6.0.2",
    "@lezer/highlight": "^1.2.3",
    "@mdx-js/mdx": "^3.1.1",
    "@pragma/constants": "workspace:*",
    "@pragma/plugin": "workspace:*",
    "@pragma/scratchpad": "workspace:*",
    "@pragma/scratchpad-viewer": "workspace:*",
    "@pragma/sdk": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2",
    "@tiptap/extension-code-block-lowlight": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-list": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.20.0-beta.291",
    "@xterm/xterm": "6.1.0-beta.292",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "color": "^5.0.3",
    "culori": "^4.0.2",
    "esbuild-wasm": "^0.27.3",
    "fuzzysort": "^3.1.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "octokit": "^5.0.5",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "resolve.exports": "^2.0.3",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "uqr": "^0.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/core": "^3.27.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
