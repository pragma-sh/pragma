{
  "name": "pragma",
  "version": "1.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate": "bun scripts/generate-emoji-catalog.ts",
    "preview": "vite preview",
    "predev": "bun run generate && bun run --filter @pragma-sh/constants generate && bun run --filter @pragma-sh/scratchpad build && bun run --filter @pragma-sh/scratchpad-viewer build",
    "prebuild": "bun run generate && bun run --filter @pragma-sh/constants generate && bun run --filter @pragma-sh/sdk build && bun run --filter @pragma-sh/plugin build && bun run --filter @pragma-sh/scratchpad build && bun run --filter @pragma-sh/scratchpad-viewer build",
    "typecheck": "tsc -b --noEmit",
    "pretypecheck": "bun run generate",
    "test": "bun --bun vitest run",
    "pretest": "bun run generate",
    "lint": "oxlint .",
    "tauri": "tauri",
    "sidecar:server": "bun ../../scripts/run-shell-script.ts src-tauri/scripts/stage-daemon-sidecar.sh",
    "sidecar:server:release": "bun ../../scripts/run-shell-script.ts src-tauri/scripts/stage-daemon-sidecar.sh --release",
    "web:stage": "bun ../../scripts/stage-web-bundle.ts",
    "tauri:dev": "bunx turbo run build --filter @pragma-sh/dev-test-plugin && bun run sidecar:server && bun run web:stage && bun scripts/tauri-dev.ts",
    "tauri:build": "tauri build"
  },
