{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "include-component-in-tag": true,
  "separate-pull-requests": false,
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "desktop",
      "components": [
        "pragma",
        "pragma-desktop",
        "pragma-protocol",
        "pragma-server",
        "pragma-gateway",
        "pragma-cli",
        "pragma-client",
        "pragma-core",
        "pragma-platform",
        "constants",
        "plugin",
        "sdk",
        "scratchpad",
        "scratchpad-contract",
        "scratchpad-viewer",
        "automations",
        "ai-helpers",
        "github-helpers",
        "sidecar-kit",
        "plugins-host",
        "watcher",
        "watcher-kit",
        "create-pragma-plugin"
      ],
      "merge": false
    },
    {
      "type": "node-workspace",
      "updatePeerDependencies": true
    }
  ],
  "packages": {
    "apps/pragma": {
      "release-type": "node",
      "component": "pragma",
      "release-as": "1.0.0",
      "extra-files": [
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "apps/pragma/src-tauri": {
      "release-type": "rust",
      "component": "pragma-desktop",
      "release-as": "1.0.0",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "apps/pragma-go": {
      "release-type": "node",
      "component": "pragma-go"
    },
    "apps/www": {
      "release-type": "node",
      "component": "www"
    },
    "crates/pragma-protocol": {
      "release-type": "rust",
      "component": "pragma-protocol",
      "release-as": "1.0.0"
    },
    "crates/pragma-server": {
      "release-type": "rust",
      "component": "pragma-server",
      "release-as": "1.0.0"
    },
    "crates/pragma-gateway": {
      "release-type": "rust",
      "component": "pragma-gateway",
      "release-as": "1.0.0"
    },
    "crates/pragma-cli": {
      "release-type": "rust",
      "component": "pragma-cli",
      "release-as": "1.0.0"
    },
    "crates/pragma-client": {
      "release-type": "rust",
      "component": "pragma-client",
      "release-as": "1.0.0"
    },
    "crates/pragma-core": {
      "release-type": "rust",
      "component": "pragma-core",
      "release-as": "1.0.0"
    },
    "crates/pragma-platform": {
      "release-type": "rust",
      "component": "pragma-platform",
      "release-as": "1.0.0"
    },
    "packages/constants": {
      "release-type": "node",
      "component": "constants",
      "release-as": "1.0.0",
      "extra-files": [
        {
          "type": "json",
          "path": "values.json",
          "jsonpath": "$.app.version"
        },
        {
          "type": "json",
          "path": "values.json",
          "jsonpath": "$.daemon.protocolVersion"
        }
      ]
    },
    "packages/plugin": {
      "release-type": "node",
      "component": "plugin",
      "release-as": "1.0.0"
    },
    "packages/sdk": {
      "release-type": "node",
      "component": "sdk",
      "release-as": "1.0.0"
    },
    "packages/scratchpad": {
      "release-type": "node",
      "component": "scratchpad",
      "release-as": "1.0.0"
    },
    "packages/scratchpad-contract": {
      "release-type": "node",
      "component": "scratchpad-contract",
      "release-as": "1.0.0"
    },
    "packages/scratchpad-viewer": {
      "release-type": "node",
      "component": "scratchpad-viewer",
      "release-as": "1.0.0"
    },
    "packages/automations": {
      "release-type": "node",
      "component": "automations",
      "release-as": "1.0.0"
    },
    "packages/ai-helpers": {
      "release-type": "node",
      "component": "ai-helpers",
      "release-as": "1.0.0"
    },
    "packages/github-helpers": {
      "release-type": "node",
      "component": "github-helpers",
      "release-as": "1.0.0"
    },
    "packages/sidecar-kit": {
      "release-type": "node",
      "component": "sidecar-kit",
      "release-as": "1.0.0"
    },
    "packages/plugins-host": {
      "release-type": "node",
      "component": "plugins-host",
      "release-as": "1.0.0"
    },
    "packages/create-pragma-plugin": {
      "release-type": "node",
      "component": "create-pragma-plugin",
      "release-as": "1.0.0"
    },
    "packages/bench": {
      "release-type": "rust",
      "component": "bench",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "packages/watcher": {
      "release-type": "node",
      "component": "watcher",
      "release-as": "1.0.0"
    },
    "packages/watcher-kit": {
      "release-type": "node",
      "component": "watcher-kit",
      "release-as": "1.0.0"
    },
    "packages/opencode-plugin": {
      "release-type": "node",
      "component": "opencode-plugin"
    },
    "packages/claude-code-plugin": {
      "release-type": "node",
      "component": "claude-code-plugin"
    },
    "packages/cursor-plugin": {
      "release-type": "node",
      "component": "cursor-plugin"
    },
    "packages/codex-plugin": {
      "release-type": "node",
      "component": "codex-plugin"
    },
    "packages/pi-plugin": {
      "release-type": "node",
      "component": "pi-plugin"
    },
    "packages/prime-agent-plugin": {
      "release-type": "node",
      "component": "prime-agent-plugin"
    },
    "packages/grok-plugin": {
      "release-type": "node",
      "component": "grok-plugin"
    },
    "packages/kimi-plugin": {
      "release-type": "node",
      "component": "kimi-plugin"
    },
    "packages/junie-plugin": {
      "release-type": "node",
      "component": "junie-plugin"
    },
    "packages/github-copilot-cli-plugin": {
      "release-type": "node",
      "component": "github-copilot-cli-plugin"
    },
    "packages/dev-test-plugin": {
      "release-type": "node",
      "component": "dev-test-plugin"
    }
  },
  "initial-version": "0.1.0"
}
